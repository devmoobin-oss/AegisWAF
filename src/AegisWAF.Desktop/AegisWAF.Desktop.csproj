<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AegisWAF</AssemblyName>
    <RootNamespace>AegisWAF.Desktop</RootNamespace>
    <Version>0.10.3</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- The gateway runs inside this process (Kestrel on background threads), so the exe is self-sufficient. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\AegisWAF.Client\AegisWAF.Client.csproj">
      <!-- Both references are single-target projects; avoid redundant cross-targeting/workload resolution during publish. -->
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <ProjectReference Include="..\AegisWAF.Gateway\AegisWAF.Gateway.csproj">
      <!-- Both references are single-target projects; avoid redundant cross-targeting/workload resolution during publish. -->
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <!-- The single-file desktop app extracts these embedded assets to a private temp folder at runtime. -->
    <EmbeddedResource Include="..\AegisWAF.Gateway\wwwroot\index.html">
      <LogicalName>AegisWAF.WebAssets.index.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\AegisWAF.Gateway\wwwroot\assets\app.js">
      <LogicalName>AegisWAF.WebAssets.assets.app.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\AegisWAF.Gateway\wwwroot\assets\style.css">
      <LogicalName>AegisWAF.WebAssets.assets.style.css</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
