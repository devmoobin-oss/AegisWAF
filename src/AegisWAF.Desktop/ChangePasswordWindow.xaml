<Window x:Class="AegisWAF.Desktop.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="เปลี่ยนรหัสผ่าน" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" FontFamily="Segoe UI">
    <Border Style="{StaticResource Card}" Margin="20" Padding="24">
        <StackPanel>
            <TextBlock Text="เปลี่ยนรหัสผ่าน" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="Note" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,16" FontSize="12.5"/>
            <TextBlock Text="รหัสผ่านปัจจุบัน" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,5"/>
            <PasswordBox x:Name="CurrentBox" Margin="0,0,0,12"/>
            <TextBlock Text="รหัสผ่านใหม่" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,5"/>
            <PasswordBox x:Name="NewBox" Margin="0,0,0,12"/>
            <TextBlock Text="ยืนยันรหัสผ่านใหม่" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,5"/>
            <PasswordBox x:Name="ConfirmBox" Margin="0,0,0,10"/>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Red}" TextWrapping="Wrap" MinHeight="18" FontSize="12.5" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="ยกเลิก" Style="{StaticResource Ghost}" IsCancel="True" Margin="0,0,10,0"/>
                <Button x:Name="SaveButton" Content="บันทึก" IsDefault="True" Click="OnSave"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
