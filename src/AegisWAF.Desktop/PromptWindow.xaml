<Window x:Class="AegisWAF.Desktop.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" FontFamily="Segoe UI">
    <Border Style="{StaticResource Card}" Margin="20" Padding="22">
        <StackPanel>
            <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,0,14"/>
            <PasswordBox x:Name="Box" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="ยกเลิก" Style="{StaticResource Ghost}" IsCancel="True" Margin="0,0,10,0"/>
                <Button Content="ตกลง" IsDefault="True" Click="OnOk"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
