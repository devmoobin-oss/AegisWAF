<Window x:Class="AegisWAF.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AegisWAF — Security Command Center" Width="1500" Height="920" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" FontFamily="Segoe UI" UseLayoutRounding="True" PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="76"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{StaticResource Blue}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="24" FontWeight="SemiBold"><Run Text="Aegis"/><Run Text="WAF" Foreground="{StaticResource Blue}"/></TextBlock>
                            <TextBlock Text="Web Application Firewall" Style="{StaticResource MutedText}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="1" Margin="10,16,10,0">
                    <RadioButton x:Name="NavOwasp" Style="{StaticResource NavButton}" Tag="&#xE72E;" Content="OWASP Top 10" GroupName="nav" Checked="OnNav"/>
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="ภาพรวม" GroupName="nav" IsChecked="True" Checked="OnNav"/>
                    <RadioButton x:Name="NavCommandCenter" Style="{StaticResource NavButton}" Tag="&#xE9D9;" Content="Security Command Center" GroupName="nav" Checked="OnNav"/>
                    <RadioButton x:Name="NavEvents" Style="{StaticResource NavButton}" Tag="&#xE7BA;" Content="เหตุการณ์ที่ถูกบล็อก" GroupName="nav" Checked="OnNav"/>
                    <RadioButton x:Name="NavRules" Style="{StaticResource NavButton}" Tag="&#xE72E;" Content="กฎการป้องกัน" GroupName="nav" Checked="OnNav"/>
                    <RadioButton x:Name="NavProtect" Style="{StaticResource NavButton}" Tag="&#xE946;" Content="ระบบป้องกันอะไรได้บ้าง" GroupName="nav" Checked="OnNav"/>
                    <RadioButton x:Name="NavSites" Style="{StaticResource NavButton}" Tag="&#xE8FD;" Content="Multi-Site Gateway" GroupName="nav" Checked="OnNav"/>
                    <RadioButton x:Name="NavIps" Style="{StaticResource NavButton}" Tag="&#xE774;" Content="IP ที่บล็อก / อนุญาต" GroupName="nav" Checked="OnNav"/>
                    <RadioButton x:Name="NavUsers" Style="{StaticResource NavButton}" Tag="&#xE716;" Content="ผู้ใช้งานระบบ" GroupName="nav" Checked="OnNav"/>
                    <RadioButton x:Name="NavAudit" Style="{StaticResource NavButton}" Tag="&#xE8A5;" Content="ประวัติการใช้งาน" GroupName="nav" Checked="OnNav"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="ตั้งค่า" GroupName="nav" Checked="OnNav"/>
                </StackPanel>
                <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,16">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="14" Height="14" Stroke="{StaticResource Green}" StrokeThickness="3" Margin="0,0,10,0"/>
                        <TextBlock Text="AegisWAF" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="VersionText" Text="v0.10.0 · OWASP mapped" Style="{StaticResource MutedText}" FontSize="12" Margin="8,1,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="26,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PageHint" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource Green}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="กำลังเชื่อมต่อ" Foreground="{StaticResource Green}" FontSize="13" Margin="0,0,24,0" VerticalAlignment="Center"/>
                        <Border Width="38" Height="38" CornerRadius="19" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#9CC8FF" Offset="0"/><GradientStop Color="#5A98E8" Offset="1"/></LinearGradientBrush>
                            </Border.Background>
                            <TextBlock x:Name="AvatarText" Foreground="#0E2744" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UserText" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="RoleText" Style="{StaticResource MutedText}" FontSize="11"/>
                        </StackPanel>
                        <Button Content="เปลี่ยนรหัสผ่าน" Style="{StaticResource Ghost}" Margin="0,0,8,0" Click="OnChangePassword"/>
                        <Button Content="ออกจากระบบ" Style="{StaticResource Ghost}" Click="OnLogout"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl x:Name="Host" Grid.Row="1" Margin="22,18,22,0"/>
            <TextBlock Grid.Row="2" x:Name="Footer" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,10"
                       Text="Local desktop console • ข้อมูลแดชบอร์ดเป็นสถิติในหน่วยความจำตั้งแต่ Gateway เริ่มทำงาน"/>
        </Grid>
    </Grid>
</Window>
