<UserControl x:Class="AegisWAF.Desktop.Views.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ActionText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource Red}"/>
            <Style.Triggers><DataTrigger Binding="{Binding Action}" Value="RATE LIMIT"><Setter Property="Foreground" Value="{StaticResource Orange}"/></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource MutedText}" VerticalAlignment="Center" FontSize="12"/>
                <TextBox x:Name="Filter" Width="340" HorizontalAlignment="Left" TextChanged="OnFilter" Tag="ค้นหา IP, URL, Rule หรือ Method"/>
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="แสดง 20 เหตุการณ์ล่าสุด (เหตุการณ์ทั้งหมดถูกบันทึกในฐานข้อมูลแล้ว) • ค้นหาด้วย IP, URL หรือประเภทภัยคุกคามได้ที่ช่องด้านบน" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,10"/>
            <DataGrid x:Name="Grid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="เวลา" Binding="{Binding LocalTime}" Width="160"/>
                    <DataGridTextColumn Header="ภัยคุกคามที่พบ" Binding="{Binding Explanation}" Width="2*"/>
                    <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="80"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="140"/>
                    <DataGridTextColumn Header="URL" Binding="{Binding Path}" Width="2*"/>
                    <DataGridTemplateColumn Header="ผลลัพธ์" Width="110">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Action}" Style="{StaticResource ActionText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="จัดการ" Width="130">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <Button Content="บล็อก IP นี้" Style="{StaticResource Danger}" Padding="10,4" Click="OnBlockIp"
                                    IsEnabled="{Binding CanBlock, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="กัน IP นี้ออกถาวร (ต้องใช้สิทธิ์ผู้ปฏิบัติการขึ้นไป)"/>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
