<UserControl x:Class="AegisWAF.Desktop.Views.IpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="รายการ IP แบบ exact match เท่านั้น • Allow ข้ามกฎ WAF และ Rate Limit • Block ปฏิเสธคำขอ" Style="{StaticResource MutedText}" FontSize="12.5" Margin="0,0,0,12"/>
            <StackPanel x:Name="Form" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox x:Name="IpBox" Width="220" Margin="0,0,10,0" Tag="IPv4 / IPv6"/>
                <ComboBox x:Name="ActionBox" Width="120" Margin="0,0,10,0" SelectedIndex="0">
                    <ComboBoxItem Content="block"/><ComboBoxItem Content="allow"/>
                </ComboBox>
                <TextBox x:Name="ReasonBox" Width="300" Margin="0,0,10,0" Tag="เหตุผล"/>
                <Button Content="บันทึก" Click="OnSave"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" x:Name="Msg" MinHeight="20" Margin="0,0,0,8" FontSize="12.5" TextWrapping="Wrap"/>
            <DataGrid x:Name="Grid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="1.2*"/>
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="*"/>
                    <DataGridTextColumn Header="เหตุผล" Binding="{Binding Reason}" Width="2*"/>
                    <DataGridTemplateColumn Header="จัดการ" Width="110">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <Button x:Name="Del" Content="ลบ" Style="{StaticResource Danger}" Padding="12,4" Click="OnDelete" IsEnabled="{Binding CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
