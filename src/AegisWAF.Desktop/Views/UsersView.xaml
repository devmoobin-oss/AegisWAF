<UserControl x:Class="AegisWAF.Desktop.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AegisWAF.Client;assembly=AegisWAF.Client">
    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="บัญชีที่สร้างโดยผู้ดูแลต้องตั้งรหัสผ่านใหม่ในการเข้าสู่ระบบครั้งแรก • การเปลี่ยนสิทธิ์มีผลทันที • ต้องมี SUPER_ADMIN ที่เปิดใช้งานอย่างน้อย 1 บัญชี"/>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <StackPanel Margin="0,0,10,8"><TextBlock Text="Username (a-z 0-9 . _ -)" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"/><TextBox x:Name="NName" Width="190"/></StackPanel>
                <StackPanel Margin="0,0,10,8"><TextBlock Text="ชื่อที่แสดง" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"/><TextBox x:Name="NDisplay" Width="190"/></StackPanel>
                <StackPanel Margin="0,0,10,8"><TextBlock Text="รหัสผ่านชั่วคราว" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"/><PasswordBox x:Name="NPass" Width="210"/></StackPanel>
                <StackPanel Margin="0,0,10,8"><TextBlock Text="Role" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"/><ComboBox x:Name="NRole" Width="190"/></StackPanel>
                <Button Content="สร้างผู้ใช้" Margin="0,19,0,8" VerticalAlignment="Top" Click="OnCreate"/>
            </WrapPanel>
            <TextBlock DockPanel.Dock="Top" x:Name="Msg" MinHeight="20" Margin="0,0,0,8" FontSize="12.5" TextWrapping="Wrap"/>
            <DataGrid x:Name="Grid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                    <DataGridTextColumn Header="ชื่อ" Binding="{Binding DisplayName}" Width="1.2*"/>
                    <DataGridTemplateColumn Header="Role" Width="210">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <ComboBox ItemsSource="{x:Static c:RoleNames.All}" SelectedItem="{Binding Role, Mode=OneWay}" SelectionChanged="OnRoleChanged"/>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="สถานะ" Binding="{Binding Status}" Width="110"/>
                    <DataGridTextColumn Header="เข้าสู่ระบบล่าสุด" Binding="{Binding LastLogin}" Width="150"/>
                    <DataGridTemplateColumn Header="จัดการ" Width="340">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="เปิด/ปิดใช้งาน" Padding="10,4" Margin="0,0,6,0" Click="OnToggle"/>
                                <Button Content="รีเซ็ตรหัสผ่าน" Padding="10,4" Margin="0,0,6,0" Style="{StaticResource Ghost}" Click="OnReset"/>
                                <Button Content="ยกเลิกเซสชัน" Padding="10,4" Style="{StaticResource Ghost}" Click="OnRevoke"/>
                            </StackPanel>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
