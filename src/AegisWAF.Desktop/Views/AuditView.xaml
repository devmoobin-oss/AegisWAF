<UserControl x:Class="AegisWAF.Desktop.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" x:Name="Note" Text="บันทึกการยืนยันตัวตนและการเปลี่ยนแปลงการตั้งค่า (100 รายการล่าสุด)" Style="{StaticResource MutedText}" FontSize="12.5" Margin="0,0,0,12"/>
            <DataGrid x:Name="Grid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="เวลา" Binding="{Binding LocalTime}" Width="160"/>
                    <DataGridTextColumn Header="ผู้ใช้" Binding="{Binding Actor}" Width="*"/>
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="1.3*"/>
                    <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="2*"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding ClientIp}" Width="130"/>
                    <DataGridTextColumn Header="ผลลัพธ์" Binding="{Binding Outcome}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
