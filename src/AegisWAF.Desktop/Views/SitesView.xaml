<UserControl x:Class="AegisWAF.Desktop.Views.SitesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Unloaded="OnUnloaded">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Multi-Site Gateway" FontSize="20" FontWeight="SemiBold"/>
            <Border Background="#0F4B3D" BorderBrush="#2AD4C0" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="12,0,0,0">
                <TextBlock Text="OWASP policy per Site" Foreground="#6EF0C6" FontWeight="SemiBold"/>
            </Border>
            <Border Background="#102744" BorderBrush="#2E5B86" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="8,0,0,0">
                <TextBlock x:Name="VersionText" Foreground="#B8D8F2" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,8,0,12">
            <TextBlock x:Name="Msg" Text="เพิ่ม Site ใหม่ได้จากฟอร์มด้านล่าง ระบบจะตรวจสอบและทำให้ route ใช้งานทันที" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock x:Name="SummaryText" Text="กำลังโหลดภาพรวม health trend..." Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <Button x:Name="RetrySummaryButton" Content="ลองใหม่" Style="{StaticResource Ghost}" Padding="12,4" Margin="10,0,0,0" Visibility="Collapsed" Click="OnRetrySummary"/>
                <TextBlock Text="เหตุผล" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <ComboBox x:Name="CancellationReasonFilter" Width="140" SelectedIndex="0" SelectionChanged="OnCancellationReasonFilterChanged" KeyboardNavigation.IsTabStop="True" AutomationProperties.Name="ตัวกรองเหตุผลการยกเลิก refresh">
                    <ComboBoxItem Content="ทั้งหมด" Tag="none"/>
                    <ComboBoxItem Content="superseded" Tag="superseded"/>
                    <ComboBoxItem Content="unloaded" Tag="unloaded"/>
                    <ComboBoxItem Content="retry" Tag="retry"/>
                </ComboBox>
            </StackPanel>
            <Expander x:Name="RecoveryDetailsExpander" Header="รายละเอียด recovery" IsExpanded="False" Visibility="Collapsed" Margin="0,4,0,0" KeyboardNavigation.IsTabStop="True">
                <StackPanel>
                    <TextBlock x:Name="RecoveryEventsText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock x:Name="RecoveryDiagnosticsText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <Button x:Name="CopyRecoveryDiagnosticsButton" Content="คัดลอก diagnostics" Style="{StaticResource Ghost}" Padding="12,4" Margin="0,6,0,0" Click="OnCopyRecoveryDiagnostics"/>
                    <Button x:Name="CopyRecoveryTimelineButton" Content="คัดลอก recovery timeline" Style="{StaticResource Ghost}" Padding="12,4" Margin="0,6,0,0" Click="OnCopyRecoveryTimeline"/>
                </StackPanel>
            </Expander>
        </StackPanel>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
            <Grid x:Name="AddSiteForm">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="เพิ่ม Site" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="รหัส Site (Site ID)" Style="{StaticResource MutedText}"/><TextBox x:Name="SiteIdBox" Tag="ชื่อสั้นสำหรับอ้างอิง เช่น shop-prod" ToolTip="รหัสประจำ Site ใช้ตัวอักษรภาษาอังกฤษตัวพิมพ์เล็ก ตัวเลข ขีดกลาง หรือขีดล่าง"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="ชื่อโฮสต์ที่ผู้ใช้เรียก (Hostname)" Style="{StaticResource MutedText}"/><TextBox x:Name="HostnamesBox" Tag="เช่น affiliateiq.localhost (ห้ามซ้ำกับ Site อื่น)" ToolTip="ชื่อโดเมนหรือชื่อโฮสต์ที่ผู้ใช้ส่งเข้ามา คั่นหลายชื่อด้วยเครื่องหมายจุลภาค และห้ามซ้ำกับ Site อื่น"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="เส้นทาง URL ที่เปิดให้บริการ (Path)" Style="{StaticResource MutedText}"/><TextBox x:Name="PathBox" Text="/" ToolTip="เส้นทางที่อนุญาตให้เข้าถึง เช่น / หรือ /api หากมีหลายเส้นทางให้คั่นด้วยเครื่องหมายจุลภาค"/></StackPanel>
                </Grid>
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="ปลายทางเว็บจริง (Upstream)" Style="{StaticResource MutedText}"/><TextBox x:Name="UpstreamBox" Tag="เช่น https://origin.example.com/" ToolTip="URL ของเว็บจริงที่ Gateway จะส่งคำขอไปให้ ต้องเป็น HTTP หรือ HTTPS ที่ถูกต้อง"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="โฮสต์ปลายทางที่อนุญาต (Egress)" Style="{StaticResource MutedText}"/><TextBox x:Name="AllowedHostsBox" Tag="เว้นว่างเพื่อใช้ host ของ Upstream" ToolTip="รายชื่อโฮสต์ปลายทางที่ Site นี้อนุญาตให้เชื่อมต่อ คั่นหลายชื่อด้วยเครื่องหมายจุลภาค"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="นโยบาย WAF" Style="{StaticResource MutedText}"/><TextBox x:Name="WafPolicyBox" Text="default" ToolTip="ชุดกฎ WAF ที่ใช้ตรวจคำขอของ Site นี้ โดย default คือกฎมาตรฐาน"/></StackPanel>
                </Grid>
                <Grid Grid.Row="3" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.5*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="ปลายทางสำรองเพิ่มเติม" Style="{StaticResource MutedText}"/><TextBox x:Name="UpstreamsBox" Tag="รหัส=URL&#59;สำรอง=https://origin-b/&#64;100" ToolTip="กำหนด Upstream หลายตัวในรูปแบบ รหัส=URL@น้ำหนัก คั่นแต่ละตัวด้วยเครื่องหมายอัฒภาค"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="เส้นทางตรวจสุขภาพ" Style="{StaticResource MutedText}"/><TextBox x:Name="HealthPathBox" Text="/" ToolTip="เส้นทางที่ใช้ตรวจว่า Upstream ยังพร้อมให้บริการ เช่น /health"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="จำกัดคำขอ (ครั้ง/ช่วงเวลา)" Style="{StaticResource MutedText}"/><TextBox x:Name="RateRequestsBox" Text="300/60" ToolTip="จำนวนคำขอสูงสุดต่อ Site และช่วงเวลาเป็นวินาที เช่น 300/60 หมายถึง 300 ครั้งต่อ 60 วินาที"/></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="จำกัดคำขอรวมทุก Site" Style="{StaticResource MutedText}"/><TextBox x:Name="RateGlobalBox" Text="10000" ToolTip="เพดานคำขอรวมของทุก Site ในช่วงเวลาที่กำหนด"/></StackPanel>
                </Grid>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="โหมด Production: ปลายทางต้องใช้ HTTPS และ Egress ต้องตรงกับปลายทาง" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    <CheckBox x:Name="AllowPrivateExceptionsBox" Content="อนุญาตปลายทางภายในเครื่อง (ทดสอบเท่านั้น)" ToolTip="เปิดเฉพาะเครื่องทดสอบเพื่อให้ Active Probe ตรวจ localhost หรือ 127.0.0.1 ได้ Production จะไม่อนุญาต" Margin="18,0,0,0" VerticalAlignment="Center"/>
                    <Button x:Name="AddSiteButton" Content="เพิ่ม Site" Margin="18,0,0,0" Click="OnAddSite" Padding="18,8"/>
                    <Button x:Name="CancelEditButton" Content="ยกเลิกแก้ไข" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnCancelEdit" Padding="18,8" Visibility="Collapsed"/>
                    <Button Content="โหลดข้อมูลใหม่" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnRefresh" Padding="18,8" ToolTip="โหลดรายการ Site และสถานะล่าสุดจาก Gateway"/>
                </StackPanel>
            <TextBlock Grid.Row="5" x:Name="FormHint" Text="ตัวอย่างสำหรับเครื่องทดสอบ: Hostname ใช้ affiliateiq.localhost (ไม่ใส่พอร์ต) และ Upstream ใช้ http://localhost:4000/ — Hostname ต้องไม่ซ้ำกับ Site อื่น" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
            </Grid>
        </Border>
        <DataGrid x:Name="Grid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="รหัส Site" Binding="{Binding SiteId}" Width="1.2*"/>
                <DataGridTextColumn Header="ชื่อโฮสต์" Binding="{Binding HostnamesText}" Width="2*"/>
                <DataGridTextColumn Header="ปลายทางเว็บจริง" Binding="{Binding UpstreamsText}" Width="2*"/>
                <DataGridTextColumn Header="สุขภาพระบบ" Binding="{Binding Health}" Width="*"/>
                <DataGridTextColumn Header="แนวโน้ม" Binding="{Binding TrendText}" Width="1.2*"/>
                <DataGridTemplateColumn Header="การแจ้งเตือน" Width="*">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <TextBlock Text="{Binding AlertText}" Foreground="{Binding AlertBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="OWASP" Binding="{Binding WafPolicy}" Width="*"/>
                <DataGridTemplateColumn Header="จัดการ" Width="330">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="เช็ค Healthy" Style="{StaticResource Ghost}" Padding="10,4" Click="OnHealthCheck"/>
                            <Button Content="รับทราบ 1 ชม." Style="{StaticResource Ghost}" Padding="10,4" Margin="6,0,0,0" Click="OnAcknowledgeAlert" IsEnabled="{Binding CanAcknowledge}"/>
                            <Button Content="แก้ไข" Style="{StaticResource Ghost}" Padding="10,4" Click="OnEditSite" IsEnabled="{Binding CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Button Content="ลบ" Style="{StaticResource Danger}" Padding="10,4" Margin="6,0,0,0" Click="OnDeleteSite" IsEnabled="{Binding CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </StackPanel>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
