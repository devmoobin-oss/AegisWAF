<UserControl x:Class="AegisWAF.Desktop.Views.SitesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Multi-Site Gateway" FontSize="20" FontWeight="SemiBold"/>
            <Border Background="#0F4B3D" BorderBrush="#2AD4C0" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="12,0,0,0">
                <TextBlock Text="OWASP policy per Site" Foreground="#6EF0C6" FontWeight="SemiBold"/>
            </Border>
            <Border Background="#102744" BorderBrush="#2E5B86" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="8,0,0,0">
                <TextBlock x:Name="VersionText" Foreground="#B8D8F2" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>
        <TextBlock Grid.Row="1" x:Name="Msg" Text="เพิ่ม Site ใหม่ได้จากฟอร์มด้านล่าง ระบบจะตรวจสอบก่อนบันทึก และต้อง Restart Gateway เพื่อเปิดใช้งาน route" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,12"/>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
            <Grid x:Name="AddSiteForm">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="เพิ่ม Site" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Site ID" Style="{StaticResource MutedText}"/><TextBox x:Name="SiteIdBox" Tag="เช่น shop-prod"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Hostname(s)" Style="{StaticResource MutedText}"/><TextBox x:Name="HostnamesBox" Tag="คั่นด้วย comma เช่น shop.example.com"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Path prefix" Style="{StaticResource MutedText}"/><TextBox x:Name="PathBox" Text="/"/></StackPanel>
                </Grid>
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Upstream URL" Style="{StaticResource MutedText}"/><TextBox x:Name="UpstreamBox" Tag="https://origin.example.com/"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Egress allowed host(s)" Style="{StaticResource MutedText}"/><TextBox x:Name="AllowedHostsBox" Tag="เว้นว่างเพื่อใช้ host ของ upstream"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="WAF policy" Style="{StaticResource MutedText}"/><TextBox x:Name="WafPolicyBox" Text="default"/></StackPanel>
                </Grid>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Production: upstream ต้องเป็น HTTPS และ Egress ต้องตรงกับปลายทาง" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    <Button x:Name="AddSiteButton" Content="เพิ่ม Site" Margin="18,0,0,0" Click="OnAddSite" Padding="18,8"/>
                    <Button x:Name="CancelEditButton" Content="ยกเลิกแก้ไข" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnCancelEdit" Padding="18,8" Visibility="Collapsed"/>
                    <Button Content="Refresh" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnRefresh" Padding="18,8"/>
                </StackPanel>
                <TextBlock Grid.Row="4" x:Name="FormHint" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
            </Grid>
        </Border>
        <DataGrid x:Name="Grid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SiteId" Binding="{Binding SiteId}" Width="1.2*"/>
                <DataGridTextColumn Header="Hostnames" Binding="{Binding HostnamesText}" Width="2*"/>
                <DataGridTextColumn Header="Upstreams" Binding="{Binding UpstreamsText}" Width="2*"/>
                <DataGridTextColumn Header="Health" Binding="{Binding Health}" Width="*"/>
                <DataGridTextColumn Header="OWASP" Binding="{Binding WafPolicy}" Width="*"/>
                <DataGridTemplateColumn Header="จัดการ" Width="230">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="เช็ค Healthy" Style="{StaticResource Ghost}" Padding="10,4" Click="OnHealthCheck"/>
                            <Button Content="แก้ไข" Style="{StaticResource Ghost}" Padding="10,4" Click="OnEditSite" IsEnabled="{Binding CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Button Content="ลบ" Style="{StaticResource Danger}" Padding="10,4" Margin="6,0,0,0" Click="OnDeleteSite" IsEnabled="{Binding CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </StackPanel>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
