<UserControl x:Class="AegisWAF.Desktop.Views.CommandCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DecisionText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Decision}" Value="ALLOWED"><Setter Property="Foreground" Value="{StaticResource Green}"/></DataTrigger>
                <DataTrigger Binding="{Binding Decision}" Value="BLOCKED"><Setter Property="Foreground" Value="{StaticResource Red}"/></DataTrigger>
                <DataTrigger Binding="{Binding Decision}" Value="RATE LIMITED"><Setter Property="Foreground" Value="{StaticResource Orange}"/></DataTrigger>
                <DataTrigger Binding="{Binding Decision}" Value="UPSTREAM ERROR"><Setter Property="Foreground" Value="{StaticResource Orange}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,16">
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="LiveDot" Width="9" Height="9" Fill="{StaticResource Green}" Margin="0,0,7,0"/>
                        <TextBlock x:Name="LiveStatus" Text="LIVE • refresh 2s" Foreground="{StaticResource Green}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Security Command Center" Style="{StaticResource H2}"/>
                        <TextBlock Text="ดู traffic ที่ผ่าน Gateway, upstream ที่เลือก และผลการตรวจความปลอดภัยแบบ sanitized" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,5,0" Padding="14,12"><StackPanel><TextBlock Text="Active connections" Style="{StaticResource MutedText}" FontSize="12"/><TextBlock x:Name="ActiveText" Text="—" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="5,0" Padding="14,12"><StackPanel><TextBlock Text="Requests/min" Style="{StaticResource MutedText}" FontSize="12"/><TextBlock x:Name="RequestsText" Text="—" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="5,0" Padding="14,12"><StackPanel><TextBlock Text="Allowed" Style="{StaticResource MutedText}" FontSize="12"/><TextBlock x:Name="AllowedText" Text="—" Foreground="{StaticResource Green}" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Grid.Column="3" Style="{StaticResource Card}" Margin="5,0" Padding="14,12"><StackPanel><TextBlock Text="Blocked" Style="{StaticResource MutedText}" FontSize="12"/><TextBlock x:Name="BlockedText" Text="—" Foreground="{StaticResource Red}" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource Card}" Margin="5,0" Padding="14,12"><StackPanel><TextBlock Text="Rate limited" Style="{StaticResource MutedText}" FontSize="12"/><TextBlock x:Name="RateText" Text="—" Foreground="{StaticResource Orange}" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Grid.Column="5" Style="{StaticResource Card}" Margin="5,0,0,0" Padding="14,12"><StackPanel><TextBlock Text="Upstream errors" Style="{StaticResource MutedText}" FontSize="12"/><TextBlock x:Name="ErrorsText" Text="—" Foreground="{StaticResource Orange}" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource Card}" Padding="16,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBox x:Name="SearchBox" Width="300" Tag="ค้นหา IP, site, hostname, path หรือ rule" TextChanged="OnFilterChanged"/>
                        <ComboBox x:Name="DecisionBox" Width="150" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                            <ComboBoxItem Content="All decisions" Tag=""/><ComboBoxItem Content="ALLOWED" Tag="Allowed"/><ComboBoxItem Content="BLOCKED" Tag="Blocked"/><ComboBoxItem Content="RATE LIMITED" Tag="RateLimited"/><ComboBoxItem Content="UPSTREAM ERROR" Tag="UpstreamError"/>
                        </ComboBox>
                        <TextBlock x:Name="CountText" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="NoticeText" DockPanel.Dock="Bottom" Text="Live view จำกัด 500 รายการ และไม่แสดง body, cookie, authorization หรือ raw query" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <DataGrid x:Name="TrafficGrid" IsReadOnly="True" AutoGenerateColumns="False" MinHeight="310">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding LocalTime}" Width="145"/>
                            <DataGridTextColumn Header="Client IP" Binding="{Binding ClientIp}" Width="125"/>
                            <DataGridTextColumn Header="Site / Hostname" Binding="{Binding SiteHostDisplay}" Width="190"/>
                            <DataGridTextColumn Header="Method / Path" Binding="{Binding RequestDisplay}" Width="2*"/>
                            <DataGridTextColumn Header="Forwarded to" Binding="{Binding UpstreamDisplay}" Width="210"/>
                            <DataGridTemplateColumn Header="Decision" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Decision}" Style="{StaticResource DecisionText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusCode}" Width="65"/>
                            <DataGridTextColumn Header="Latency" Binding="{Binding DurationDisplay}" Width="85"/>
                            <DataGridTextColumn Header="Rule / OWASP" Binding="{Binding SecurityDisplay}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="EmptyText" Text="ยังไม่มี traffic ที่ตรงกับตัวกรอง" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,22" Visibility="Collapsed"/>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
