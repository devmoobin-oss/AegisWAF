<UserControl x:Class="AegisWAF.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,16" MaxWidth="860" HorizontalAlignment="Left">
            <Border x:Name="RemoteNote" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
                <TextBlock x:Name="RemoteText" TextWrapping="Wrap" FontSize="13" LineHeight="22"/>
            </Border>
            <StackPanel x:Name="LocalPanel">
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="PostgreSQL Database" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0"><TextBlock Text="Host" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,4"/><TextBox x:Name="DbHost"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Port" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,4"/><TextBox x:Name="DbPort"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Database name" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,4"/><TextBox x:Name="DbName"/></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0"><TextBlock Text="Username" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,4"/><TextBox x:Name="DbUser"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Password (blank = keep current)" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,4"/><PasswordBox x:Name="DbPass"/></StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Test database connection" Style="{StaticResource Ghost}" Click="OnTestDb"/>
                            <TextBlock x:Name="DbResult" TextWrapping="Wrap" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="13" MaxWidth="560"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Gateway listener" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                        <TextBlock Text="Port used by users to access AegisWAF" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="ListenPort" Width="140" HorizontalAlignment="Left"/>
                        <TextBlock Text="Protected websites and upstream routes are managed in Multi-Site Gateway." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="SaveButton" Content="Save and restart Gateway" Click="OnSave"/>
                </StackPanel>
                <TextBlock x:Name="SaveResult" TextWrapping="Wrap" FontSize="13" Margin="0,6,0,18" MinHeight="18"/>

                <Border Style="{StaticResource Card}" BorderBrush="#5A2A35">
                    <StackPanel>
                        <TextBlock Text="Reset local setup" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,12"
                                   Text="Removes the encrypted local connection settings and returns to the setup wizard. Database data, users and rules are not deleted."/>
                        <Button Content="Reset settings and start setup again" Style="{StaticResource Danger}" HorizontalAlignment="Left" Click="OnReset"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock x:Name="About" Style="{StaticResource MutedText}" FontSize="12" Margin="2,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
