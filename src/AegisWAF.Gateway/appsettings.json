{
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Database": { "RequireLeastPrivilege": false, "AutoMigrate": true },
  "Waf": { "AllowProtocolUpgrade": false, "AllowUnsafeMethods": false,
    "AllowedMethods": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
    "Limits": { "MaxRequestLineBytes": 16384, "MaxRequestHeadersBytes": 65536, "MaxRequestBodyBytes": 1048576, "KeepAliveSeconds": 120, "RequestHeadersTimeoutSeconds": 10 },
    "RateLimit": { "Requests": 300, "GlobalRequests": 10000, "Store": "memory", "WindowSeconds": 60, "MaxEntries": 10000 },
    "MaxBodyInspectBytes": 131072, "MaxResponseInspectBytes": 262144, "ResponseOverflowAction": "stream",
    "InspectBinaryRequests": false, "InspectResponses": true, "InspectBinaryResponses": false,
    "Inspection": { "MaxCompressedBytes": 131072, "MaxDecompressedBytes": 1048576, "MaxExpansionRatio": 100, "MaxNestingDepth": 32, "MaxMembers": 10000, "MaxMultipartParts": 100, "TimeoutMilliseconds": 250 },
    "Events": { "StructuredLogging": true },
    "Egress": { "AllowedHosts": [], "AllowedPorts": [443], "AllowedSchemes": ["https"], "AllowPrivateExceptions": false } },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "Auth": { "Throttle": { "Store": "memory", "MaxEntries": 10000, "MaxFailures": 10, "WindowMinutes": 15 } },
  "ConnectionStrings": { "Postgres": "Host=localhost;Port=5432;Database=aegiswaf;Username=postgres;Pooling=true" },
  "Admin": { "AllowRemote": false, "RequireHttps": true },
  "Security": { "TrustedProxies": [] },
  "ReverseProxy": {
    "Routes": { "route1": { "ClusterId": "appcluster", "Match": { "Path": "{**catch-all}" } } },
    "Clusters": { "appcluster": { "HttpRequest": { "ActivityTimeout": "00:00:30" }, "Destinations": { "app1": { "Address": "http://localhost:8080/" } } } }
  }
}
