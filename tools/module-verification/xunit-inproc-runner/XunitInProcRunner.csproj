<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="xunit.abstractions"><HintPath>..\..\..\tests\AegisWAF.Tests\bin\Debug\net10.0\xunit.abstractions.dll</HintPath></Reference>
    <Reference Include="xunit.core"><HintPath>..\..\..\tests\AegisWAF.Tests\bin\Debug\net10.0\xunit.core.dll</HintPath></Reference>
    <Reference Include="xunit.execution.dotnet"><HintPath>..\..\..\tests\AegisWAF.Tests\bin\Debug\net10.0\xunit.execution.dotnet.dll</HintPath></Reference>
    <Reference Include="AegisWAF.Tests"><HintPath>..\..\..\tests\AegisWAF.Tests\bin\Debug\net10.0\AegisWAF.Tests.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Functional tests hosted by WebApplicationFactory resolve the application
         dependency context from the runner output directory. Keep the test and
         gateway dependency manifests beside the in-process runner so database
         integration tests exercise the real host instead of failing in bootstrap. -->
    <None Include="..\..\..\tests\AegisWAF.Tests\bin\Debug\net10.0\*.deps.json"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- GatewayApp selects AppContext.BaseDirectory when a wwwroot is present.
         Supplying the real static content gives the standalone in-process host a
         valid content root even when the runner is launched outside dotnet test. -->
    <Content Include="..\..\..\src\AegisWAF.Gateway\wwwroot\**\*"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\src\AegisWAF.Gateway\appsettings.json"
             Link="appsettings.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
