<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <!-- Fixed per product line; never change across versions so MajorUpgrade can find/replace prior installs. -->
  <?define ProductUpgradeCode = "4CAD54FA-674B-4149-B621-CA80BFDCBF35" ?>
  <?ifndef SourceDir ?>
  <?define SourceDir = "..\dist\AegisWAF-Setup-Build" ?>
  <?endif ?>
  <?ifndef ProductVersion ?>
  <?define ProductVersion = "0.10.3" ?>
  <?endif ?>

  <Package Name="AegisWAF"
           Manufacturer="AegisWAF"
           Version="$(ProductVersion)"
           UpgradeCode="$(ProductUpgradeCode)"
           Scope="perMachine"
           InstallerVersion="500">

    <SummaryInformation Description="AegisWAF Web Application Firewall - Setup" Manufacturer="AegisWAF" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of AegisWAF is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.exe" SourceFile="$(SourceDir)\AegisWAF.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.exe" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="AegisWAF">

        <Component Id="MainExecutable" Guid="*">
          <File Id="AegisWAFExe" Source="$(SourceDir)\AegisWAF.exe" KeyPath="yes">
            <Shortcut Id="StartMenuShortcut"
                      Directory="ApplicationProgramsFolder"
                      Name="AegisWAF"
                      Description="AegisWAF Web Application Firewall"
                      WorkingDirectory="INSTALLFOLDER"
                      Advertise="yes" />
            <Shortcut Id="DesktopShortcut"
                      Directory="DesktopFolder"
                      Name="AegisWAF"
                      Description="AegisWAF Web Application Firewall"
                      WorkingDirectory="INSTALLFOLDER"
                      Advertise="yes" />
          </File>
          <!-- Opt-in exception, inert until the app actually listens; failing offline/locked-down machines must not block install. -->
          <fw:FirewallException Id="AegisWAFFirewallException"
                                 Name="AegisWAF"
                                 Description="AegisWAF Web Application Firewall"
                                 Program="[#AegisWAFExe]"
                                 Scope="any"
                                 IgnoreFailure="yes" />
        </Component>

        <Component Id="AppSettings" Guid="*">
          <File Id="AppSettingsJson" Source="$(SourceDir)\appsettings.json" KeyPath="yes" />
        </Component>

        <Component Id="RuntimeConfig" Guid="*">
          <File Id="RuntimeConfigJson" Source="$(SourceDir)\AegisWAF.Gateway.runtimeconfig.json" KeyPath="yes" />
        </Component>

      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="AegisWAF">
        <Component Id="ApplicationShortcutFolder" Guid="*">
          <RemoveFolder Id="CleanUpStartMenuFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\AegisWAF" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="MainFeature" Title="AegisWAF" Level="1" AllowAbsent="no" AllowAdvertise="no">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="AppSettings" />
      <ComponentRef Id="RuntimeConfig" />
      <ComponentRef Id="ApplicationShortcutFolder" />
    </Feature>

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" />

  </Package>
</Wix>
